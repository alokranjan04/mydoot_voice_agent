# ── Mydoot Customer Care Voice Agent — Environment Template ──────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Telephony (Vobiz)
PORT=5050                             # Server port — must match Vobiz Answer URL

# STT — Deepgram
DEEPGRAM_API_KEY="your_deepgram_api_key_here"

# LLM — Sarvam
SARVAM_API_KEY="your_sarvam_api_key_here"

# LLM — Google Gemini (Pipeline B — optional)
GEMINI_API_KEY="your_gemini_api_key_here"

# TTS — ElevenLabs (optional — falls back to Sarvam Bulbul v2 if not set)
ELEVEN_LABS_API_KEY="your_elevenlabs_api_key_here"

# Google Sheets — where customer feedback is saved
GOOGLE_SPREADSHEET_ID="your_google_spreadsheet_id_here"
GOOGLE_CREDENTIALS='{"type": "service_account", "project_id": "...", "private_key": "...", ...}'
# Alternatively, place the service account JSON file at google-credentials.json (gitignored)
